// NEXUS Social Media Aggregator - Prisma schema
// Uses SQLite for zero-config local development. For production, switch the
// datasource provider to "postgresql" and point DATABASE_URL at Postgres 15
// (per the BRD). The application code is provider-agnostic.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  bio          String   @default("")
  avatarUrl    String   @default("")
  theme        String   @default("light")
  createdAt    DateTime @default(now())

  // Account lockout (Phase B3): counts consecutive failed login attempts,
  // reset to 0 on a successful login. lockedUntil is set once the count
  // hits the threshold and cleared (implicitly, by expiring) once it's
  // passed — see lib/loginLockout.ts.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // Phase B2: null until the user completes the email verification flow.
  emailVerifiedAt DateTime?

  connections         Connection[]
  feedPosts           FeedPost[]
  publishJobs         PublishJob[]
  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
}

// Phase B2: hashed, single-use tokens backing both password reset and email
// verification. One model instead of two near-identical ones — purpose
// discriminates them, and consumeVerificationToken() (lib/verificationTokens.ts)
// always checks it, so a token issued for one flow can't be replayed against
// the other even though tokenHash alone would already be globally unique.
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  purpose   String // "password_reset" | "email_verify"
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  // SHA-256 hash of the raw token (hex). The raw token itself only ever
  // exists in the httpOnly cookie handed to the browser and the one-time
  // response when it's issued/rotated — never stored, never logged.
  // Refresh tokens are high-entropy random values, not user-chosen
  // secrets, so a fast hash is appropriate here (unlike passwords).
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  // Set when this token was rotated into a newer one, so a revoked token
  // being presented again (reuse after rotation) is a detectable signal
  // of possible theft, not just "expired normally."
  replacedByHash String?
  userAgent      String   @default("") // for a future session-list UI (Phase B4)
  ipAddress      String   @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Connection {
  id          String   @id @default(cuid())
  userId      String
  platform    String // twitter | threads | bluesky | mastodon
  handle      String
  displayName String   @default("")
  instance    String   @default("") // mastodon instance, optional
  status      String   @default("active") // active | expired | error
  createdAt   DateTime @default(now())

  // Credentials below are encrypted at rest (AES-256-GCM via DATA_KEY, see
  // src/lib/crypto.ts). Never populate these with plaintext tokens.
  accessTokenEnc  String    @default("") // encrypted OAuth access token
  refreshTokenEnc String    @default("") // encrypted OAuth refresh token
  tokenExpiresAt  DateTime? // OAuth access token expiry, if applicable
  appPasswordEnc  String    @default("") // encrypted app password (e.g. Bluesky)
  scopes          String    @default("") // space-separated OAuth scopes granted
  metadata        String    @default("{}") // JSON blob for connector-specific extras

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedPosts FeedPost[]

  @@unique([userId, platform, handle])
  @@index([userId])
}

model FeedPost {
  id           String   @id @default(cuid())
  userId       String
  connectionId String?
  platform     String
  externalId   String
  authorHandle String
  authorName   String
  authorAvatar String   @default("")
  content      String
  mediaUrls    String   @default("[]") // JSON array of image URLs
  likeCount    Int      @default(0)
  repostCount  Int      @default(0)
  replyCount   Int      @default(0)
  liked        Boolean  @default(false)
  bookmarked   Boolean  @default(false)
  isOwn        Boolean  @default(false) // true if authored by the user via cross-post
  postedAt     DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  // Phase D3: the same remote post must never appear twice in a user's feed
  // — without this, a periodic sync (Phase D1) re-fetching an unchanged
  // timeline would insert duplicates every tick. Scoped per user (not
  // globally) since two different NEXUS users legitimately each get their
  // own FeedPost row for the same underlying remote post.
  @@unique([userId, platform, externalId])
  @@index([userId, postedAt])
}

model PublishJob {
  id          String   @id @default(cuid())
  userId      String
  content     String
  mediaUrls   String   @default("[]")
  scheduledAt DateTime?
  createdAt   DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets PublishTarget[]

  @@index([userId, createdAt])
}

model PublishTarget {
  id         String   @id @default(cuid())
  jobId      String
  platform   String
  status     String   @default("pending") // pending | success | failed
  externalId String   @default("")
  error      String   @default("")
  latencyMs  Int      @default(0)

  job PublishJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
