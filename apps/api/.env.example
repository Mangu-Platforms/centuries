# NEXUS API configuration
# Local dev uses SQLite (zero setup). For production, switch the Prisma
# datasource provider to postgresql and use a Postgres URL here.
DATABASE_URL="file:./dev.db"

# Secret used to sign JWT access tokens. Override in production with a long
# random value, e.g. `openssl rand -base64 48`. Never reuse this dev default
# outside local development.
JWT_SECRET="dev-super-secret-change-me"

# Port the API listens on.
PORT=4000

# Comma-separated list of allowed CORS origins (frontend dev server).
CORS_ORIGIN="http://localhost:3000"

# This API's own publicly reachable base URL. Used to build the OAuth
# redirect_uri registered with third-party services (Phase C2+: Mastodon
# today). Must be reachable by the browser and by the third-party service —
# in production this is your deployed API's public URL, not localhost.
API_PUBLIC_URL="http://localhost:4000"

# The web app's base URL. Used as an OAuth flow's final redirect target and
# as the "website" field on dynamically-registered OAuth apps. Defaults to
# the first CORS_ORIGIN entry if unset.
WEB_APP_URL="http://localhost:3000"

# --- Connection credential encryption (Phase A4) ---
# 32-byte key (64 hex chars) used to encrypt connector credentials
# (OAuth tokens, app passwords) at rest via AES-256-GCM. Generate with
# `openssl rand -hex 32`. Required in production; a fixed dev-only default
# is used automatically when unset locally so the demo flow keeps working.
DATA_KEY=""

# --- Live connectors: Bluesky (Phase C1 — shipped) ---
# No developer app needed — users supply their own app password at connect
# time, which is encrypted and stored per-connection. Nothing required here.
# Optional override if you run against a non-default AT Protocol PDS/entryway.
BLUESKY_SERVICE_URL="https://bsky.social"

# --- Live connectors: Mastodon (Phase C2 — shipped) ---
# No global app registration needed — NEXUS registers a per-instance OAuth
# app dynamically against whatever instance the user supplies (see
# API_PUBLIC_URL / WEB_APP_URL above, which this flow depends on). Nothing
# platform-specific to set here.

# --- Live connectors: X / Twitter (Phase C3) — WAITING-ON-HUMAN ---
# Requires an approved X developer app (OAuth 2.0, PKCE). Leave unset to
# keep the Twitter card in demo mode with a "waiting on credentials" UI state.
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_REDIRECT_URI="http://localhost:3000/dashboard/connections/callback/twitter"

# --- Live connectors: Instagram + Threads (Phase C4) — WAITING-ON-HUMAN ---
# Requires an approved Meta developer app (Instagram Graph API / Threads API).
# Leave unset to keep these cards in demo mode.
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/dashboard/connections/callback/meta"

# --- Scheduler (Phase E2) ---
# Shared secret required on requests to POST /internal/tick, which fires
# scheduled PublishJobs. Generate with `openssl rand -hex 32`.
CRON_SECRET=""
